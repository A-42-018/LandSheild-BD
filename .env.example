DATABASE_URL=sqlite:///./landshield.db
JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
AUTH_RATE_LIMIT_PER_MIN=10
PUBLIC_RATE_LIMIT_PER_MIN=60
UPLOAD_RATE_LIMIT_PER_HOUR=20   # per user
APP_ENV=dev                   # dev | prod (prod refuses to start with weak JWT_SECRET/HASH_SALT, http cookies or non-https CORS)
COOKIE_SECURE=false           # true behind HTTPS
COOKIE_SAMESITE=lax           # lax | strict | none (none when the site and the API are on different domains, e.g. Netlify + Render; needs COOKIE_SECURE=true)
CORS_ORIGINS=http://localhost:3000
STORAGE_PATH=./storage
# OCR (O1-O3). The site works fully with NO API key: Tesseract + rules is the default path.
OCR_PROVIDER=auto            # auto (demo fixture -> pdf-text -> tesseract) | tesseract | mock (tests)
DEMO_FIXTURES=on             # on = the saved demo samples return their stored result (labelled "Demo sample"); off = real OCR on them too
DOCUMENT_AI_PROVIDER=auto    # auto (claude if ANTHROPIC_API_KEY else rules) | rules | claude | mock (tests)
ANTHROPIC_API_KEY=           # empty = Claude disabled. Never logged, never sent to the frontend. When set, page images + OCR text go to Anthropic.
CLAUDE_MODEL=claude-haiku-4-5-20251001   # switch to claude-sonnet-5-5 if accuracy is weak
# Optional: an Anthropic-compatible gateway instead of api.anthropic.com (e.g. Meta Model API: https://api.meta.ai with ANTHROPIC_AUTH=bearer and CLAUDE_MODEL=<a model it lists>).
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH=x-api-key   # x-api-key (Anthropic) | bearer (Authorization: Bearer)
CLAUDE_DAILY_CAP=100        # max Claude calls/day; over the cap -> rules
CLAUDE_TIMEOUT_S=30          # per call; timeout -> rules
OCR_TIMEOUT_S=30             # Tesseract, per page
OCR_MAX_PAGES=5              # PDF pages processed; the rest is dropped with warning PAGES_TRUNCATED
DOCUMENT_AI_MODEL=
EMBEDDING_MODEL=             # unused until P2
REVIEW_CONF_THRESHOLD=0.85
PREPROCESS=on                # OpenCV clean-up (grayscale, denoise, CLAHE, deskew, crop) before Tesseract
ML_SCORING=on                 # on | off; anomaly hint adds 0-15 points, never HIGH alone
ML_MODEL_PATH=                # empty = models/iforest.joblib
TESSERACT_LANG=ben+eng     # missing languages are dropped with a log warning
DEMO_PASSWORD=
# Ed25519 record signing (F4a). SIGNING_KEY = base64url 32-byte seed (use on hosts with ephemeral disk, e.g. Render); else the PEM at SIGNING_KEY_PATH
# (default <STORAGE_PATH>/signing/ed25519.pem, auto-generated in dev, gitignored). Neither usable -> in-memory key (signatures lost on restart).
SIGNING_KEY=
SIGNING_KEY_PATH=
HASH_SALT=                    # salt for ip/nid/contact hashes (set in real use)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Street basemap for /map. Unset = OpenStreetMap standard tiles (demo use only, see docs/gis.md); "off" = blank offline background.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Mouza lists need a dataset that is not bundled (synthetic-data-only rule). Empty = off.
MOUZA_ENABLED_DIVISION_ID=
# GIS_DATA_DIR=   # default: <repo>/database/gis
